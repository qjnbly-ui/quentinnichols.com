---
/**
 * The body of a long-form entry (`"layout": "story"` in posts.json): an intro, then chapters with
 * openers, beats, counting figures, and a finale. Content comes unchanged from the original post
 * (src/data/story.ts); motion lives in src/lib/story.ts.
 */
import type { Story } from "../data/story";
interface Props {
  story: Story;
}
const { story } = Astro.props;
---

<Fragment set:html={story.intro} />
{story.chapters.map((chapter) => (
  <section class="story-chapter" id={chapter.id}>
    <h2 class="chapter-title" data-reveal><span set:html={chapter.title} /></h2>
    <Fragment set:html={chapter.html} />
  </section>
))}
<script>
  import { initStory } from "../lib/story";
  initStory();
</script>
