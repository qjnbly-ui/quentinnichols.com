---
const workspace = import.meta.env.PUBLIC_COMMUNICATIONS_WORKSPACE || "";
---

<div data-subscription data-workspace={workspace}>
  <div class="notice subscribe-unavailable" data-subscription-unavailable>
    <p>
      Email updates aren’t open for signup yet. In the meantime, you can follow
      my YouTube channel or read what’s new at N3XRA.
    </p>
    <a class="text-link" href="https://www.youtube.com/@quentin.j.nichols">Follow on YouTube</a>
  </div>
  <form class="form" data-subscription-form hidden>
    <h2>Choose your updates.</h2>
    <label>
      Your name
      <input name="fullName" autocomplete="name" maxlength="160" />
    </label>
    <label>
      Email address
      <input
        name="email"
        type="email"
        autocomplete="email"
        maxlength="320"
        required
      />
    </label>
    <fieldset data-subscription-topics>
      <legend>What would you like to hear about?</legend>
    </fieldset>
    <label class="check">
      <input type="checkbox" name="emailConsent" required />
      <span data-email-disclosure></span>
    </label>
    <p class="help" data-email-terms></p>
    <p class="help">
      You can unsubscribe from email updates.{" "}
      <a data-subscription-privacy href="/privacy/">
        Privacy
      </a>{" "}
      ·{" "}
      <a
        data-subscription-terms
        href="https://www.n3xra.com/nexra-communications/terms/"
      >
        Messaging terms
      </a>
    </p>
    <div class="honeypot" aria-hidden="true">
      <label>
        Company
        <input name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button class="button" type="submit">
      Subscribe to updates
    </button>
    <p class="form-status" aria-live="polite" data-subscription-status></p>
  </form>
</div>
<script>
  interface Disclosure {
    version: string;
    text?: string;
    disclosure?: string;
    disclosure_text?: string;
    checkbox_label?: string;
  }
  interface Workspace {
    sourceToken: string;
    topics: { id: string; name: string; description?: string }[];
    channels: { email: { available: boolean; disclosure: Disclosure | null } };
    privacyPolicyUrl?: string;
    programTermsUrl?: string;
    form: { successMessage: string };
  }
  const root = document.querySelector<HTMLElement>("[data-subscription]");
  const workspace = root?.dataset.workspace;
  const form = root?.querySelector<HTMLFormElement>("form");
  let config: Workspace | undefined;
  let key = crypto.randomUUID();
  if (workspace && form) {
    fetch(
      `https://www.n3xra.com/api/communications-public?workspace=${encodeURIComponent(workspace)}&sourceType=website_embed`,
      { headers: { Accept: "application/json" } },
    )
      .then(async (response) => {
        if (!response.ok) throw new Error("Unavailable");
        return response.json() as Promise<Workspace>;
      })
      .then((data) => {
        if (
          !data.sourceToken ||
          !data.channels.email.available ||
          !data.channels.email.disclosure
        )
          throw new Error("Unavailable");
        const disclosure = data.channels.email.disclosure;
        const disclosureText =
          disclosure.text ||
          disclosure.disclosure ||
          disclosure.disclosure_text;
        if (!disclosureText || !disclosure.version)
          throw new Error("Unavailable");
        config = data;
        const topics = form.querySelector("[data-subscription-topics]")!;
        data.topics.forEach((topic) => {
          const label = document.createElement("label");
          label.className = "check";
          const input = document.createElement("input");
          input.type = "checkbox";
          input.name = "topic";
          input.value = topic.id;
          const text = document.createElement("span");
          text.textContent = topic.name;
          label.append(input, text);
          topics.append(label);
        });
        if (!data.topics.length) (topics as HTMLElement).hidden = true;
        form.querySelector("[data-email-disclosure]")!.textContent =
          disclosure.checkbox_label || disclosureText;
        form.querySelector("[data-email-terms]")!.textContent = disclosureText;
        const terms = form.querySelector<HTMLAnchorElement>(
          "[data-subscription-terms]",
        );
        if (terms && data.programTermsUrl?.startsWith("https://"))
          terms.href = data.programTermsUrl;
        const privacy = form.querySelector<HTMLAnchorElement>(
          "[data-subscription-privacy]",
        );
        if (privacy && data.privacyPolicyUrl?.startsWith("https://"))
          privacy.href = data.privacyPolicyUrl;
        root!.querySelector<HTMLElement>(
          "[data-subscription-unavailable]",
        )!.hidden = true;
        form.hidden = false;
      })
      .catch(() => {
        /* Keep a useful, truthful alternative when signup is unavailable. */
      });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!config || !form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>("button")!;
      const status = form.querySelector<HTMLElement>(
        "[data-subscription-status]",
      )!;
      button.disabled = true;
      status.textContent = "Saving your preferences…";
      const values = new FormData(form);
      try {
        const response = await fetch(
          `https://www.n3xra.com/api/communications-public?workspace=${encodeURIComponent(workspace!)}`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              workspace,
              sourceToken: config.sourceToken,
              idempotencyKey: key,
              sourcePage: location.href,
              fullName: values.get("fullName"),
              email: values.get("email"),
              company: values.get("company"),
              emailConsent: values.get("emailConsent") === "on",
              smsConsent: false,
              topicIds: values.getAll("topic"),
              consentVersions: {
                email: config.channels.email.disclosure!.version,
              },
            }),
          },
        );
        const result = await response.json();
        if (!response.ok || !result.ok)
          throw new Error(
            result.error ||
              "Your preferences could not be saved. Please try again.",
          );
        status.textContent = result.message || config.form.successMessage;
        form.reset();
        key = crypto.randomUUID();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Please try again.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
