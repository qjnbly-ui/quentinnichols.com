---
import Site from "../layouts/Site.astro";
import Film from "../components/Film.astro";
import Tools from "../components/Tools.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import { videos, visionChapters } from "../data/site";
import posts from "../data/posts.json";
import { getArticles } from "../data/articles";
const [featured, ...moreVideos] = videos;
// The newest entry leads as a large feature when it uses the long-form story layout.
const newest = getArticles().find((article) => article.url === posts[0]!.url);
const featureStory = newest?.story ? newest : null;
const latestWriting = posts.slice(featureStory ? 1 : 0, featureStory ? 4 : 3);
const isoDate = (date: string) => new Date(date).toISOString().slice(0, 10);
const beyond = [
  {
    href: "/photography/",
    image: "/images/photo-0.webp",
    alt: "Rocky shoreline on the Oregon coast",
    title: "Photography",
    text: "A reason to slow down and look.",
  },
  {
    href: "/about-me/#recreation-center",
    image: "/images/gym.webp",
    alt: "Quentin at the door of the Gearhart Gym in Bly",
    title: "The recreation center",
    text: "Restoring Bly’s community gym since 2016.",
  },
  {
    href: "/about-me/#tree-work",
    image: "/images/tree-work-forest.jpg",
    alt: "Quentin in a hard hat at the base of an old-growth tree",
    title: "Tree work",
    text: "Apprentice to journeyman to foreman with Trees, LLC.",
  },
  {
    href: "/about-me/#firefighting",
    image: "/images/firefighting.jpg",
    alt: "Wildland firefighting crew walking out at sunrise during guard school",
    title: "Firefighting & EMT",
    text: "Guard school, Firefighter 1, and EMT training to serve Bly.",
  },
  {
    href: "/about-me/#new-zealand",
    image: "/images/photo-2.webp",
    alt: "Mountain landscape in New Zealand",
    title: "Travel",
    text: "New Zealand, the road, and the stories in between.",
  },
];
---

<Site title="Quentin Nichols">
  <section class="opening" aria-labelledby="home-title" data-opening>
    <div class="opening-photo" aria-hidden="true">
      <img
        src="/images/quentin-outdoors.webp"
        alt=""
        width="1600"
        height="1069"
        fetchpriority="high"
      />
    </div>
    <div class="opening-shade" aria-hidden="true"></div>
    <div class="opening-content wrap">
      <h1 id="home-title" class="signature">
        <img src="/images/quentin-logo.webp" sizes="(max-width: 700px) 82vw, 560px" alt="Quentin Nichols" width="1455" height="341" />
        <span class="signature-sweep" aria-hidden="true"></span>
      </h1>
      <p class="opening-founder">
        Founder of
        <a href="https://www.n3xra.com/">
          <img src="/images/n3xra-wordmark-tight.webp" alt="N3XRA" width="1382" height="203" />
        </a>
      </p>
      <p class="opening-intro">
        Based in Bly, Oregon, I focus on the small details of life: the landscapes, the stories that came before us,
        and the creative work happening today. This site brings together the projects, photographs, and ideas I’m
        building along the way.
      </p>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </section>

  <section class="chapter" aria-labelledby="n3xra-title" data-chapter>
    <div class="chapter-stage wrap">
      <div class="chapter-mark" aria-hidden="true">
        <div class="emblem">
          <img src="/images/n3xra-emblem.webp" alt="" width="700" height="700" loading="lazy" />
          <span class="emblem-sweep"></span>
        </div>
      </div>
      <div class="chapter-copy">
        <p class="eyebrow" data-reveal>The company I’m building</p>
        <h2 id="n3xra-title" data-reveal style="--d:1">Why N3XRA matters to me.</h2>
        <ol class="chapter-rail" aria-hidden="true">
          {visionChapters.map(() => <li />)}
        </ol>
        <div class="statements">
          {visionChapters.map((chapter, index) => (
            <article class="statement" data-reveal style={`--d:${index + 2}`}>
              <p class="statement-label">{chapter.label}</p>
              <h3>{chapter.title}</h3>
              <p>{chapter.summary}</p>
            </article>
          ))}
        </div>
        <div class="actions">
          <a class="button" href="/vision/">Read my vision for N3XRA</a>
          <a class="button button--ghost" href="https://www.n3xra.com/">Visit N3XRA</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="tools-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">Using what I build</p>
        <h2 id="tools-title" class="runs-on">
          This site runs on
          <img src="/images/n3xra-wordmark-tight.webp" alt="N3XRA" width="1382" height="203" />
        </h2>
      </div>
      <p>I use my own products here first. What I improve for this site can help every customer who uses them.</p>
    </div>
    <Tools />
    <div class="link-list" data-reveal>
      <a class="text-link" href="/projects/">See the work I’ve built</a>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="videos-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">From my YouTube channel</p>
        <h2 id="videos-title">Videos</h2>
      </div>
      <a class="text-link" href="/videos/">All videos</a>
    </div>
    <div class="films">
      <div data-reveal>
        <Film id={featured!.id} title={featured!.title} meta={featured!.tag} feature />
      </div>
      <div class="film-list">
        {moreVideos.map((video, index) => (
          <div data-reveal style={`--d:${index + 1}`}>
            <Film id={video.id} title={video.title} meta={video.tag} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="writing-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2 id="writing-title">Writing &amp; ideas</h2>
      </div>
      <a class="text-link" href="/blog/">All writing</a>
    </div>
    {featureStory && (
      <a class="story-feature spotlight" href={featureStory.url} data-reveal>
        <img
          src={`/images/stories/${featureStory.route}-1536.jpg`}
          srcset={`/images/stories/${featureStory.route}-900.jpg 900w, /images/stories/${featureStory.route}-1536.jpg 1536w`}
          sizes="(max-width: 1240px) 100vw, 1200px"
          alt=""
          loading="lazy"
        />
        <div>
          <p class="eyebrow">New journal entry · {featureStory.date}</p>
          <h3>{featureStory.title}</h3>
          <p>{featureStory.description}</p>
          <span class="button">Read the entry</span>
        </div>
      </a>
    )}
    <div class="writing-list">
      {latestWriting.map((post, index) => (
        <a class="writing-row" href={post.url} data-reveal style={`--d:${index}`}>
          <time datetime={isoDate(post.date)}>{post.date}</time>
          <h3>{post.title}</h3>
          <span class="writing-category">{post.category}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="beyond-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">Beyond the company</p>
        <h2 id="beyond-title">The rest of my life.</h2>
      </div>
      <p>N3XRA is where my ideas for the future go. These are the places, people, and work that shaped them.</p>
    </div>
    <div class="beyond">
      {beyond.map((tile, index) => (
        <a class="beyond-tile" href={tile.href} data-reveal style={`--d:${index}`}>
          <img src={tile.image} alt={tile.alt} sizes="(max-width: 860px) 100vw, 480px" loading="lazy" />
          <div>
            <h3>{tile.title}</h3>
            <p>{tile.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Get in touch</p>
      <h2 id="closing-title">Have something you want to build?</h2>
      <p class="lead">Tell me about it. For project conversations, N3XRA is the place to start.</p>
      <div class="actions">
        <a class="button" href="/contact/">Contact me</a>
        <a class="button button--ghost" href="https://www.n3xra.com/website-request/">Start a project with N3XRA</a>
      </div>
    </div>
  </section>
  <VideoPlayer />
</Site>
