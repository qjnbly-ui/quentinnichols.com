---
import Site from "../layouts/Site.astro";
import Film from "../components/Film.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import { videos } from "../data/site";
---

<Site title="Videos" description="Videos by Quentin Nichols: places, moments, and things worth sharing.">
  <header class="page-head wrap">
    <h1>Videos</h1>
    <div class="link-list">
      <a class="text-link" href="https://www.youtube.com/@quentin.j.nichols">Visit my YouTube channel</a>
    </div>
  </header>
  <section class="section wrap">
    <div class="video-grid">
      {videos.map((video, index) => (
        <article data-reveal style={`--d:${index % 2}`}>
          <Film id={video.id} title={video.title} />
          <p class="eyebrow">{video.tag}</p>
          <p>{video.description}</p>
          <a class="text-link" href={`https://www.youtube.com/watch?v=${video.id}`}>Watch on YouTube</a>
        </article>
      ))}
    </div>
  </section>
  <VideoPlayer />
</Site>
